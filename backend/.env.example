# Copy to backend/.env and adjust. All keys are prefixed GREENCODE_.
GREENCODE_DATABASE_URL=postgresql+psycopg://greencode:greencode@localhost:5432/greencode
GREENCODE_BENCHMARK_DATABASE_URL=postgresql://greencode:greencode@localhost:5432/greencode
GREENCODE_BENCHMARK_SCHEMA=bench

# ollama | mock
GREENCODE_LLM_PROVIDER=ollama
GREENCODE_OLLAMA_BASE_URL=http://localhost:11434
GREENCODE_OLLAMA_MODEL=qwen2.5-coder:7b
GREENCODE_LLM_TEMPERATURE=0.0
GREENCODE_LLM_SEED=42

GREENCODE_BENCHMARK_WARMUP_RUNS=3
GREENCODE_BENCHMARK_REPETITIONS=15
GREENCODE_SANDBOX_TIMEOUT_SECONDS=20
GREENCODE_SANDBOX_MEMORY_LIMIT_MB=512

# auto | rapl | codecarbon | estimate
GREENCODE_ENERGY_METHOD=auto
GREENCODE_CARBON_FACTOR_REGION=IE
GREENCODE_ESTIMATE_CPU_TDP_WATTS=65

# Shared secret for /api/admin/*. If unset, a random one is generated and logged at each startup.
# GREENCODE_ADMIN_TOKEN=change-me
