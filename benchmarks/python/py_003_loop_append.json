{
  "id": "py_003_loop_append",
  "title": "Loop that only appends to a list",
  "language": "python",
  "category": "redundant_operations",
  "description": "",
  "expected_rules": [
    "PY003"
  ],
  "source": "def solve(values):\n    squares = []\n    for v in values:\n        if v % 3 == 0:\n            squares.append(v * v)\n    return squares\n",
  "entry_point": "solve",
  "tests": [
    {
      "name": "basic",
      "args": "([1, 2, 3, 6],)",
      "expected": [
        9,
        36
      ]
    },
    {
      "name": "empty",
      "args": "([],)",
      "expected": []
    }
  ],
  "benchmark": {
    "setup": "values = list(range(1000000))",
    "call": "solve(values)"
  }
}
